@model global::PetCareShop.Models.ErrorViewModel

@{
    ViewData["Title"] = "Lỗi";
}

<section style="
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    background: #fff7ed;">

    <div style="
        width: min(650px, 100%);
        padding: 40px;
        border-radius: 24px;
        background: white;
        text-align: center;
        box-shadow: 0 20px 55px rgba(15, 23, 42, 0.12);">

        <h1 style="
            margin-bottom: 15px;
            color: #dc2626;
            font-size: 40px;">
            Đã xảy ra lỗi
        </h1>

        <p style="
            margin-bottom: 25px;
            color: #64748b;
            font-size: 17px;
            line-height: 1.7;">
            Hệ thống không thể xử lý yêu cầu của bạn.
            Vui lòng quay lại trang chủ và thử lại.
        </p>

        @if (Model.ShowRequestId)
        {
            <p style="
                margin-bottom: 25px;
                color: #475569;">
                <strong>Mã yêu cầu:</strong>
                <code>@Model.RequestId</code>
            </p>
        }

        <a asp-controller="Home"
           asp-action="Index"
           asp-area=""
           style="
            display: inline-block;
            padding: 13px 25px;
            border-radius: 999px;
            background: #f97316;
            color: white;
            font-weight: 800;
            text-decoration: none;">
            Quay lại trang chủ
        </a>
    </div>
</section>
