@model List<global::PetCareShop.Models.ShoppingCartItem>

@{
    ViewData["Title"] = "Đặt hàng";

    decimal total =
        ViewBag.Total == null
            ? 0
            : (decimal)ViewBag.Total;
}

<section class="page-banner">
    <div class="container">
        <h1>Đặt hàng</h1>

        <p>
            Nhập thông tin để hoàn tất đơn hàng
        </p>
    </div>
</section>

<section class="checkout-section">
    @if (TempData["Error"] != null)
    {
        <div class="container">
            <div class="error-alert">
                @TempData["Error"]
            </div>
        </div>
    }

    <div class="container checkout-layout">
        <div class="checkout-form">
            <h2>Thông tin khách hàng</h2>

            <form asp-area=""
                  asp-controller="Cart"
                  asp-action="ConfirmOrder"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label>Họ và tên</label>

                    <input type="text"
                           name="FullName"
                           value="@ViewBag.FullName"
                           placeholder="Nhập họ tên"
                           required />
                </div>

                <div class="form-group">
                    <label>Số điện thoại</label>

                    <input type="text"
                           name="Phone"
                           value="@ViewBag.Phone"
                           placeholder="Nhập số điện thoại"
                           required />
                </div>

                <div class="form-group">
                    <label>Email</label>

                    <input type="email"
                           name="Email"
                           value="@ViewBag.Email"
                           placeholder="Nhập email" />
                </div>

                <div class="form-group">
                    <label>Địa chỉ nhận hàng</label>

                    <textarea name="Address"
                              placeholder="Nhập địa chỉ nhận hàng"
                              required>@ViewBag.Address</textarea>
                </div>

                <div class="form-group">
                    <label>Ghi chú</label>

                    <textarea name="Note"
                              placeholder="Ghi chú thêm nếu có"></textarea>
                </div>

                <button type="submit"
                        class="order-btn">
                    Xác nhận đặt hàng
                </button>
            </form>
        </div>

        <div class="checkout-summary">
            <h2>Đơn hàng của bạn</h2>

            @foreach (var item in Model)
            {
                <div class="checkout-item">
                    <img src="@item.Product.ImageUrl"
                         alt="@item.Product.Name" />

                    <div>
                        <h4>@item.Product.Name</h4>

                        <p>
                            Số lượng:
                            @item.Quantity
                        </p>

                        <strong>
                            @item.Total.ToString("N0") đ
                        </strong>
                    </div>
                </div>
            }

            <div class="summary-total">
                <span>Tổng thanh toán</span>

                <strong>
                    @total.ToString("N0") đ
                </strong>
            </div>
        </div>
    </div>
</section>