@model List<global::PetCareShop.Models.ShoppingCartItem>

@{
    ViewData["Title"] = "Giỏ hàng";

    decimal total =
        ViewBag.Total == null
            ? 0
            : (decimal)ViewBag.Total;
}

<section class="page-banner">
    <div class="container">
        <h1>Giỏ hàng của bạn</h1>

        <p>
            Kiểm tra sản phẩm trước khi đặt hàng
        </p>
    </div>
</section>

<section class="cart-section">
    <div class="container">
        @if (Model.Count == 0)
        {
            <div class="empty-cart">
                <div class="empty-icon">🛒</div>

                <h2>Giỏ hàng đang trống</h2>

                <p>
                    Bạn chưa thêm sản phẩm nào
                    vào giỏ hàng.
                </p>

                <a asp-area=""
                   asp-controller="Product"
                   asp-action="Index"
                   class="btn-primary">
                    Tiếp tục mua hàng
                </a>
            </div>
        }
        else
        {
            <div class="cart-layout">
                <div class="cart-list">
                    @foreach (var item in Model)
                    {
                        <div class="cart-item">
                            <img src="@item.Product.ImageUrl"
                                 alt="@item.Product.Name" />

                            <div class="cart-info">
                                <h3>
                                    @item.Product.Name
                                </h3>

                                <p>
                                    Đơn giá:
                                    @item.Product.Price.ToString("N0") đ
                                </p>

                                <div class="quantity-box">
                                    <a asp-area=""
                                       asp-controller="Cart"
                                       asp-action="Decrease"
                                       asp-route-id="@item.ProductId">
                                        −
                                    </a>

                                    <span>
                                        @item.Quantity
                                    </span>

                                    <a asp-area=""
                                       asp-controller="Cart"
                                       asp-action="Increase"
                                       asp-route-id="@item.ProductId">
                                        +
                                    </a>
                                </div>
                            </div>

                            <div class="cart-price">
                                <strong>
                                    @item.Total.ToString("N0") đ
                                </strong>

                                <a asp-area=""
                                   asp-controller="Cart"
                                   asp-action="Remove"
                                   asp-route-id="@item.ProductId"
                                   class="remove-btn">
                                    Xóa
                                </a>
                            </div>
                        </div>
                    }
                </div>

                <div class="cart-summary">
                    <h2>Tóm tắt đơn hàng</h2>

                    <div class="summary-row">
                        <span>Tạm tính</span>

                        <strong>
                            @total.ToString("N0") đ
                        </strong>
                    </div>

                    <div class="summary-row">
                        <span>Phí vận chuyển</span>

                        <strong>Miễn phí</strong>
                    </div>

                    <div class="summary-total">
                        <span>Tổng cộng</span>

                        <strong>
                            @total.ToString("N0") đ
                        </strong>
                    </div>

                    <a asp-area=""
                       asp-controller="Cart"
                       asp-action="Checkout"
                       class="checkout-btn">
                        Tiến hành đặt hàng
                    </a>

                    <a asp-area=""
                       asp-controller="Cart"
                       asp-action="Clear"
                       class="clear-btn">
                        Xóa toàn bộ giỏ hàng
                    </a>
                </div>
            </div>
        }
    </div>
</section>