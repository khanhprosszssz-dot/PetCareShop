@model global::PetCareShop.Models.ProductDetailViewModel

@{
    ViewData["Title"] = Model.Product.Name;
}

<section class="product-detail-section">
    <div class="container detail-grid">
        <div class="detail-image">
            <img src="@Model.Product.ImageUrl" alt="@Model.Product.Name" />
        </div>

        <div class="detail-content">
            <span class="product-category">@Model.Product.Category</span>

            <h1>@Model.Product.Name</h1>

            <div class="detail-rating">
                <span class="stars">
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Math.Round(Model.AverageRating))
                        {
                            <span>★</span>
                        }
                        else
                        {
                            <span class="star-muted">★</span>
                        }
                    }
                </span>

                <small>
                    @Model.AverageRating.ToString("0.0") / 5 - @Model.ReviewCount đánh giá
                </small>
            </div>

            <div class="detail-price">
                @Model.Product.Price.ToString("N0") đ
            </div>

            <p>
                @Model.Product.Description
            </p>

            <div class="detail-box">
                <h3>Thông tin sản phẩm</h3>

                <ul>
                    <li>Sản phẩm được kiểm tra kỹ trước khi giao.</li>
                    <li>Hỗ trợ tư vấn chăm sóc sau khi mua.</li>
                    <li>Cam kết hình ảnh và mô tả rõ ràng.</li>
                    <li>Giao hàng nhanh, đóng gói cẩn thận.</li>
                </ul>
            </div>

            <div class="detail-actions">
                <a asp-controller="Cart"
                   asp-action="Add"
                   asp-route-id="@Model.Product.Id"
                   class="btn-primary">
                    Thêm vào giỏ hàng
                </a>

                <a asp-controller="Product"
                   asp-action="Index"
                   class="btn-outline">
                    Quay lại
                </a>
            </div>
        </div>
    </div>
</section>

<section class="review-section">
    <div class="container review-layout">
        <div class="review-list-box">
            <div class="review-header">
                <h2>Đánh giá sản phẩm</h2>
                <span>@Model.ReviewCount đánh giá</span>
            </div>

            @if (TempData["ReviewSuccess"] != null)
            {
                <div class="success-alert">
                    @TempData["ReviewSuccess"]
                </div>
            }

            @if (TempData["ReviewError"] != null)
            {
                <div class="error-alert">
                    @TempData["ReviewError"]
                </div>
            }

            @if (Model.Reviews.Count == 0)
            {
                <div class="no-review-box">
                    <div>⭐</div>
                    <h3>Chưa có đánh giá nào</h3>
                    <p>Hãy là người đầu tiên đánh giá sản phẩm này.</p>
                </div>
            }
            else
            {
                <div class="review-list">
                    @foreach (var review in Model.Reviews)
                    {
                        <div class="review-item">
                            <div class="review-avatar">
                                @review.CustomerName.Substring(0, 1).ToUpper()
                            </div>

                            <div class="review-content">
                                <div class="review-top">
                                    <h3>@review.CustomerName</h3>

                                    <span>
                                        @review.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                    </span>
                                </div>

                                <div class="review-stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= review.Rating)
                                        {
                                            <span>★</span>
                                        }
                                        else
                                        {
                                            <span class="star-muted">★</span>
                                        }
                                    }
                                </div>

                                <p>@review.Comment</p>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="review-form-box">
            <h2>Gửi đánh giá</h2>

            @if (Model.IsCustomerLoggedIn)
            {
                <p class="review-login-note">
                    Bạn đang đánh giá với tên:
                    <strong>@Model.CustomerName</strong>
                </p>

                <form asp-controller="Product"
                      asp-action="CreateReview"
                      method="post">

                    <input type="hidden" name="productId" value="@Model.Product.Id" />

                    <div class="form-group">
                        <label>Số sao</label>
                        <select name="rating">
                            <option value="5">5 sao - Rất tốt</option>
                            <option value="4">4 sao - Tốt</option>
                            <option value="3">3 sao - Bình thường</option>
                            <option value="2">2 sao - Chưa hài lòng</option>
                            <option value="1">1 sao - Kém</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Nội dung đánh giá</label>
                        <textarea name="comment"
                                  placeholder="Nhập nhận xét của bạn về sản phẩm"></textarea>
                    </div>

                    <button type="submit" class="review-submit-btn">
                        Gửi đánh giá
                    </button>
                </form>
            }
            else
            {
                <div class="review-login-box">
                    <p>Bạn cần đăng nhập để gửi đánh giá sản phẩm.</p>

                    <a asp-controller="CustomerAccount"
                       asp-action="Login"
                       class="btn-primary">
                        Đăng nhập ngay
                    </a>
                </div>
            }
        </div>
    </div>
</section>
