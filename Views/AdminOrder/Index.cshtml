@model List<PetCareShop.Models.Order>

@{
    ViewData["Title"] = "Quản lý đơn hàng";
}

<section class="page-banner">
    <div class="container">
        <h1>Quản lý đơn hàng</h1>
        <p>Tìm kiếm, lọc và xử lý đơn hàng của khách hàng</p>
    </div>
</section>

<section class="admin-section">
    <div class="container">
        <div class="admin-header">
            <h2>Danh sách đơn hàng</h2>

            <a asp-controller="AdminDashboard"
               asp-action="Index"
               class="admin-add-btn">
                Về Dashboard
            </a>
        </div>

        <div class="order-filter-box">
            <form asp-controller="AdminOrder"
                  asp-action="Index"
                  method="get"
                  class="order-filter-form">

                <div class="form-group">
                    <label>Tìm kiếm</label>
                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           placeholder="Tên, SĐT, email, địa chỉ..." />
                </div>

                <div class="form-group">
                    <label>Trạng thái</label>
                    <select name="status">
                        @if (string.IsNullOrEmpty(ViewBag.Status))
                        {
                            <option value="" selected>Tất cả trạng thái</option>
                        }
                        else
                        {
                            <option value="">Tất cả trạng thái</option>
                        }

                        @if (ViewBag.Status == "Chờ xác nhận")
                        {
                            <option value="Chờ xác nhận" selected>Chờ xác nhận</option>
                        }
                        else
                        {
                            <option value="Chờ xác nhận">Chờ xác nhận</option>
                        }

                        @if (ViewBag.Status == "Đã xác nhận")
                        {
                            <option value="Đã xác nhận" selected>Đã xác nhận</option>
                        }
                        else
                        {
                            <option value="Đã xác nhận">Đã xác nhận</option>
                        }

                        @if (ViewBag.Status == "Đang giao")
                        {
                            <option value="Đang giao" selected>Đang giao</option>
                        }
                        else
                        {
                            <option value="Đang giao">Đang giao</option>
                        }

                        @if (ViewBag.Status == "Hoàn thành")
                        {
                            <option value="Hoàn thành" selected>Hoàn thành</option>
                        }
                        else
                        {
                            <option value="Hoàn thành">Hoàn thành</option>
                        }

                        @if (ViewBag.Status == "Đã hủy")
                        {
                            <option value="Đã hủy" selected>Đã hủy</option>
                        }
                        else
                        {
                            <option value="Đã hủy">Đã hủy</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Từ ngày</label>
                    <input type="date"
                           name="fromDate"
                           value="@ViewBag.FromDate" />
                </div>

                <div class="form-group">
                    <label>Đến ngày</label>
                    <input type="date"
                           name="toDate"
                           value="@ViewBag.ToDate" />
                </div>

                <div class="order-filter-actions">
                    <button type="submit" class="admin-save-btn">
                        Lọc đơn hàng
                    </button>

                    <a asp-controller="AdminOrder"
                       asp-action="Index"
                       class="admin-back-btn">
                        Xóa lọc
                    </a>
                </div>
            </form>
        </div>

        <div class="order-summary-row">
            <div class="order-summary-card">
                <span>Tổng đơn đang hiển thị</span>
                <strong>@Model.Count</strong>
            </div>

            <div class="order-summary-card">
                <span>Chờ xác nhận</span>
                <strong>@Model.Count(x => x.Status == "Chờ xác nhận")</strong>
            </div>

            <div class="order-summary-card">
                <span>Đang giao</span>
                <strong>@Model.Count(x => x.Status == "Đang giao")</strong>
            </div>

            <div class="order-summary-card">
                <span>Hoàn thành</span>
                <strong>@Model.Count(x => x.Status == "Hoàn thành")</strong>
            </div>

            <div class="order-summary-card">
                <span>Đã hủy</span>
                <strong>@Model.Count(x => x.Status == "Đã hủy")</strong>
            </div>
        </div>

        <div class="admin-table-box">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Số điện thoại</th>
                        <th>Email</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.Id</td>

                            <td>@item.FullName</td>

                            <td>@item.Phone</td>

                            <td>@item.Email</td>

                            <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>

                            <td>
                                <strong class="revenue-text">
                                    @item.TotalAmount.ToString("N0") đ
                                </strong>
                            </td>

                            <td>
                                <span class="status-badge">
                                    @item.Status
                                </span>
                            </td>

                            <td>
                                <a asp-controller="AdminOrder"
                                   asp-action="Detail"
                                   asp-route-id="@item.Id"
                                   class="edit-btn">
                                    Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.Count == 0)
            {
                <div class="empty-admin">
                    Không tìm thấy đơn hàng phù hợp.
                </div>
            }
        </div>
    </div>
</section>