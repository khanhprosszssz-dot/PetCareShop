@using global::Microsoft.AspNetCore.Identity
@using global::PetCareShop.Data

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="identity-user-menu">
        <a asp-controller="CustomerProfile"
           asp-action="Index"
           asp-area="">
            @(User.Identity?.Name ?? "Tài khoản")
        </a>

        <form asp-area="Identity"
              asp-page="/Account/Logout"
              asp-route-returnUrl="/"
              method="post">

            <button type="submit">
                Đăng xuất
            </button>
        </form>
    </div>
}
else
{
    <div class="identity-user-menu">
        <a asp-area="Identity"
           asp-page="/Account/Register">
            Đăng ký
        </a>

        <a asp-area="Identity"
           asp-page="/Account/Login">
            Đăng nhập
        </a>
    </div>
}
