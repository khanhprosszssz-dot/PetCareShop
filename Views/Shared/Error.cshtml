@model global::PetCareShop.Models.ErrorViewModel

@{
    ViewData["Title"] = "Lỗi";
}

<section style="
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px 20px;
    background: #fff7ed;">

    <div style="
        width: min(650px, 100%);
        padding: 40px;
        border-radius: 24px;
        background: white;
        text-align: center;
        box-shadow: 0 20px 55px rgba(15, 23, 42, 0.12);">

        <h1 style="color: #dc2626;">
            Đã xảy ra lỗi
        </h1>

        <p>
            Hệ thống không thể xử lý yêu cầu.
            Vui lòng quay lại trang chủ và thử lại.
        </p>

        @if (Model.ShowRequestId)
        {
            <p>
                <strong>Mã yêu cầu:</strong>
                <code>@Model.RequestId</code>
            </p>
        }

        <a asp-controller="Home"
           asp-action="Index"
           asp-area="">
            Quay lại trang chủ
        </a>
    </div>
</section>
