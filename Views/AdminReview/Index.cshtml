@model List<PetCareShop.Models.ProductReview>

@{
    ViewData["Title"] = "Quản lý đánh giá";
}

<section class="page-banner">
    <div class="container">
        <h1>Quản lý đánh giá</h1>
        <p>Xem, lọc và xóa đánh giá sản phẩm của khách hàng</p>
    </div>
</section>

<section class="admin-section">
    <div class="container">
        <div class="admin-header">
            <h2>Danh sách đánh giá</h2>

            <a asp-controller="AdminDashboard"
               asp-action="Index"
               class="admin-add-btn">
                Về Dashboard
            </a>
        </div>

        <div class="admin-filter-box">
            <form asp-controller="AdminReview" asp-action="Index" method="get" class="admin-filter-form">
                <div class="form-group">
                    <label>Lọc theo sản phẩm</label>
                    <select name="productId">
                        <option value="">Tất cả sản phẩm</option>

                        @foreach (var product in ViewBag.Products)
                        {
                            if (ViewBag.ProductId != null && ViewBag.ProductId == product.Id)
                            {
                                <option value="@product.Id" selected>@product.Name</option>
                            }
                            else
                            {
                                <option value="@product.Id">@product.Name</option>
                            }
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Lọc theo số sao</label>
                    <select name="rating">
                        <option value="">Tất cả số sao</option>

                        @for (int i = 5; i >= 1; i--)
                        {
                            if (ViewBag.Rating != null && ViewBag.Rating == i)
                            {
                                <option value="@i" selected>@i sao</option>
                            }
                            else
                            {
                                <option value="@i">@i sao</option>
                            }
                        }
                    </select>
                </div>

                <div class="admin-filter-actions">
                    <button type="submit" class="admin-save-btn">
                        Lọc đánh giá
                    </button>

                    <a asp-controller="AdminReview"
                       asp-action="Index"
                       class="admin-back-btn">
                        Xóa lọc
                    </a>
                </div>
            </form>
        </div>

        <div class="admin-table-box">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã</th>
                        <th>Sản phẩm</th>
                        <th>Khách hàng</th>
                        <th>Số sao</th>
                        <th>Nội dung</th>
                        <th>Ngày đánh giá</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>#@item.Id</td>

                            <td>
                                @if (item.Product != null)
                                {
                                    @item.Product.Name
                                }
                                else
                                {
                                    <span>Không rõ</span>
                                }
                            </td>

                            <td>@item.CustomerName</td>

                            <td>
                                <span class="review-star-admin">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= item.Rating)
                                        {
                                            <span>★</span>
                                        }
                                        else
                                        {
                                            <span class="star-muted">★</span>
                                        }
                                    }
                                </span>
                            </td>

                            <td class="review-comment-cell">
                                @item.Comment
                            </td>

                            <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>

                            <td>
                                <div class="admin-actions">
                                    <a asp-controller="AdminReview"
                                       asp-action="Detail"
                                       asp-route-id="@item.Id"
                                       class="edit-btn">
                                        Xem
                                    </a>

                                    <a asp-controller="AdminReview"
                                       asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="delete-btn">
                                        Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (Model.Count == 0)
            {
                <div class="empty-admin">
                    Chưa có đánh giá nào.
                </div>
            }
        </div>
    </div>
</section>