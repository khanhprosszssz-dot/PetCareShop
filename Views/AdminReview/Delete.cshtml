@model PetCareShop.Models.ProductReview

@{
    ViewData["Title"] = "Xóa đánh giá";
}

<section class="page-banner">
    <div class="container">
        <h1>Xóa đánh giá</h1>
        <p>Xác nhận xóa đánh giá khỏi hệ thống</p>
    </div>
</section>

<section class="admin-form-section">
    <div class="container">
        <div class="delete-confirm-box">
            <div class="success-icon">⚠️</div>

            <h2>Bạn có chắc muốn xóa đánh giá này?</h2>

            <p>
                Khách hàng:
                <strong>@Model.CustomerName</strong>
            </p>

            <p>
                Sản phẩm:
                <strong>
                    @if (Model.Product != null)
                    {
                        @Model.Product.Name
                    }
                    else
                    {
                        <span>Không rõ</span>
                    }
                </strong>
            </p>

            <p>
                Số sao:
                <strong>@Model.Rating sao</strong>
            </p>

            <div class="delete-review-content">
                @Model.Comment
            </div>

            <form asp-controller="AdminReview"
                  asp-action="DeleteConfirmed"
                  method="post">

                <input type="hidden" name="id" value="@Model.Id" />

                <button type="submit" class="delete-confirm-btn">
                    Xác nhận xóa
                </button>

                <a asp-controller="AdminReview"
                   asp-action="Index"
                   class="admin-back-btn">
                    Hủy
                </a>
            </form>
        </div>
    </div>
</section>