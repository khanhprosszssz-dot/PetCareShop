@{
    ViewData["Title"] = "Giới thiệu";
}

<section class="page-banner">
    <div class="container">
        <h1>Giới thiệu PetCare Shop</h1>
        <p>Nơi kết nối những người yêu thú cưng với sản phẩm và dịch vụ chất lượng</p>
    </div>
</section>

<section class="about-section">
    <div class="container about-grid">
        <div class="about-image">
            <img src="~/images/banners/about-pet.jpg" alt="Giới thiệu PetCare Shop" />
        </div>

        <div class="about-content">
            <span class="small-title">Về chúng tôi</span>

            <h2>PetCare Shop - Đồng hành cùng thú cưng của bạn</h2>

            <p>
                PetCare Shop là cửa hàng chuyên cung cấp chó mèo cảnh, thức ăn, phụ kiện và các sản phẩm chăm sóc thú cưng.
                Website được xây dựng nhằm giúp khách hàng dễ dàng tham khảo sản phẩm, xem thông tin chi tiết và đặt hàng nhanh chóng.
            </p>

            <p>
                Chúng tôi hướng đến phong cách phục vụ chuyên nghiệp, sản phẩm rõ ràng, hình ảnh thực tế và trải nghiệm mua sắm hiện đại.
            </p>

            <div class="about-stats">
                <div>
                    <strong>500+</strong>
                    <span>Khách hàng hài lòng</span>
                </div>

                <div>
                    <strong>100+</strong>
                    <span>Sản phẩm thú cưng</span>
                </div>

                <div>
                    <strong>24/7</strong>
                    <span>Hỗ trợ tư vấn</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="mission-section">
    <div class="container">
        <h2 class="section-title">Giá trị của PetCare Shop</h2>
        <p class="section-desc">Chúng tôi không chỉ bán sản phẩm, mà còn mang đến sự an tâm cho người nuôi thú cưng</p>

        <div class="mission-grid">
            <div class="mission-card">
                <div class="mission-icon">🎯</div>
                <h3>Sứ mệnh</h3>
                <p>
                    Cung cấp sản phẩm và dịch vụ chăm sóc thú cưng chất lượng, giúp khách hàng nuôi thú cưng dễ dàng và an toàn hơn.
                </p>
            </div>

            <div class="mission-card">
                <div class="mission-icon">👁️</div>
                <h3>Tầm nhìn</h3>
                <p>
                    Trở thành một website thú cưng hiện đại, thân thiện và đáng tin cậy dành cho cộng đồng yêu chó mèo.
                </p>
            </div>

            <div class="mission-card">
                <div class="mission-icon">❤️</div>
                <h3>Cam kết</h3>
                <p>
                    Sản phẩm rõ nguồn gốc, tư vấn tận tâm, hỗ trợ khách hàng trước và sau khi mua hàng.
                </p>
            </div>
        </div>
    </div>
</section>

<section class="team-section">
    <div class="container">
        <h2 class="section-title">Dịch vụ nổi bật</h2>
        <p class="section-desc">Các nhóm dịch vụ chính dành cho khách hàng</p>

        <div class="team-grid">
            <div class="team-card">
                <img src="~/images/banners/service-1.jpg" alt="Tư vấn thú cưng" />
                <h3>Tư vấn chọn thú cưng</h3>
                <p>Hỗ trợ khách hàng lựa chọn giống chó mèo phù hợp với không gian sống và nhu cầu chăm sóc.</p>
            </div>

            <div class="team-card">
                <img src="~/images/banners/service-2.jpg" alt="Thức ăn phụ kiện" />
                <h3>Thức ăn và phụ kiện</h3>
                <p>Cung cấp các sản phẩm cần thiết như thức ăn, chuồng, đồ chơi, vòng cổ và dụng cụ vệ sinh.</p>
            </div>

            <div class="team-card">
                <img src="~/images/banners/service-3.jpg" alt="Chăm sóc thú cưng" />
                <h3>Chăm sóc sau mua</h3>
                <p>Hỗ trợ tư vấn cách chăm sóc, chế độ ăn uống và các lưu ý khi nuôi thú cưng tại nhà.</p>
            </div>
        </div>
    </div>
</section>
