@{
    ViewData["Title"] = "Liên hệ";
}

<section class="page-banner">
    <div class="container">
        <h1>Liên hệ với PetCare Shop</h1>
        <p>Chúng tôi luôn sẵn sàng hỗ trợ và tư vấn cho bạn</p>
    </div>
</section>

<section class="contact-section">
    <div class="container contact-layout">
        <div class="contact-info">
            <span class="small-title">Thông tin liên hệ</span>

            <h2>Gửi thông tin tư vấn</h2>

            <p>
                Bạn cần tư vấn về thú cưng, sản phẩm hoặc dịch vụ? Hãy để lại thông tin, PetCare Shop sẽ liên hệ lại trong thời gian sớm nhất.
            </p>

            <div class="contact-card">
                <div class="contact-icon">📍</div>
                <div>
                    <h3>Địa chỉ</h3>
                    <span>Đà Lạt, Lâm Đồng, Việt Nam</span>
                </div>
            </div>

            <div class="contact-card">
                <div class="contact-icon">📞</div>
                <div>
                    <h3>Hotline</h3>
                    <span>0909 999 999</span>
                </div>
            </div>

            <div class="contact-card">
                <div class="contact-icon">✉️</div>
                <div>
                    <h3>Email</h3>
                    <span>petcare@gmail.com</span>
                </div>
            </div>

            <div class="contact-card">
                <div class="contact-icon">⏰</div>
                <div>
                    <h3>Thời gian làm việc</h3>
                    <span>08:00 - 21:00, tất cả các ngày trong tuần</span>
                </div>
            </div>
        </div>

        <div class="contact-form">
            <h2>Form liên hệ</h2>

            <form>
                <div class="form-group">
                    <label>Họ và tên</label>
                    <input type="text" placeholder="Nhập họ và tên" />
                </div>

                <div class="form-group">
                    <label>Số điện thoại</label>
                    <input type="text" placeholder="Nhập số điện thoại" />
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <input type="email" placeholder="Nhập email" />
                </div>

                <div class="form-group">
                    <label>Nội dung</label>
                    <textarea placeholder="Bạn cần tư vấn gì?"></textarea>
                </div>

                <button type="button" class="order-btn">
                    Gửi liên hệ
                </button>
            </form>
        </div>
    </div>
</section>

<section class="map-section">
    <div class="container">
        <div class="map-box">
            <h2>Bản đồ cửa hàng</h2>
            <p>Khu vực Đà Lạt, Lâm Đồng</p>

            <div class="fake-map">
                <div>
                    <strong>PetCare Shop</strong>
                    <span>Đà Lạt, Lâm Đồng</span>
                </div>
            </div>
        </div>
    </div>
</section>