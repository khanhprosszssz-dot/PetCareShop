@model PetCareShop.Models.Customer

@{
    ViewData["Title"] = "Hồ sơ khách hàng";
}

<section class="page-banner">
    <div class="container">
        <h1>Hồ sơ khách hàng</h1>
        <p>Quản lý thông tin cá nhân và mật khẩu tài khoản</p>
    </div>
</section>

<section class="profile-section">
    <div class="container profile-layout">
        <div class="profile-sidebar">
            <div class="profile-avatar">
                @Model.FullName.Substring(0, 1).ToUpper()
            </div>

            <h2>@Model.FullName</h2>
            <p>@Model.Email</p>

            <div class="profile-menu">
                <a asp-controller="CustomerProfile" asp-action="Index" class="active">
                    Hồ sơ cá nhân
                </a>

                <a asp-controller="CustomerOrder" asp-action="Index">
                    Đơn hàng của tôi
                </a>

                <a asp-controller="Product" asp-action="Index">
                    Tiếp tục mua hàng
                </a>

                <a asp-controller="CustomerAccount" asp-action="Logout">
                    Đăng xuất
                </a>
            </div>
        </div>

        <div class="profile-content">
            <div class="profile-card">
                <h2>Thông tin cá nhân</h2>

                @if (TempData["ProfileSuccess"] != null)
                {
                    <div class="success-alert">
                        @TempData["ProfileSuccess"]
                    </div>
                }

                @if (TempData["ProfileError"] != null)
                {
                    <div class="error-alert">
                        @TempData["ProfileError"]
                    </div>
                }

                <form asp-controller="CustomerProfile"
                      asp-action="UpdateInfo"
                      method="post">

                    <div class="form-group">
                        <label>Họ và tên</label>
                        <input type="text"
                               name="FullName"
                               value="@Model.FullName"
                               placeholder="Nhập họ tên" />
                    </div>

                    <div class="form-group">
                        <label>Email</label>
                        <input type="email"
                               value="@Model.Email"
                               readonly />
                        <small class="form-note">
                            Email dùng để đăng nhập nên không chỉnh sửa tại đây.
                        </small>
                    </div>

                    <div class="form-group">
                        <label>Số điện thoại</label>
                        <input type="text"
                               name="Phone"
                               value="@Model.Phone"
                               placeholder="Nhập số điện thoại" />
                    </div>

                    <div class="form-group">
                        <label>Địa chỉ</label>
                        <textarea name="Address"
                                  placeholder="Nhập địa chỉ">@Model.Address</textarea>
                    </div>

                    <div class="form-group">
                        <label>Ngày tạo tài khoản</label>
                        <input type="text"
                               value="@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")"
                               readonly />
                    </div>

                    <button type="submit" class="profile-save-btn">
                        Lưu thay đổi
                    </button>
                </form>
            </div>

            <div class="profile-card">
                <h2>Đổi mật khẩu</h2>

                @if (TempData["PasswordSuccess"] != null)
                {
                    <div class="success-alert">
                        @TempData["PasswordSuccess"]
                    </div>
                }

                @if (TempData["PasswordError"] != null)
                {
                    <div class="error-alert">
                        @TempData["PasswordError"]
                    </div>
                }

                <form asp-controller="CustomerProfile"
                      asp-action="ChangePassword"
                      method="post">

                    <div class="form-group">
                        <label>Mật khẩu cũ</label>
                        <input type="password"
                               name="OldPassword"
                               placeholder="Nhập mật khẩu cũ" />
                    </div>

                    <div class="form-group">
                        <label>Mật khẩu mới</label>
                        <input type="password"
                               name="NewPassword"
                               placeholder="Nhập mật khẩu mới" />
                    </div>

                    <div class="form-group">
                        <label>Xác nhận mật khẩu mới</label>
                        <input type="password"
                               name="ConfirmPassword"
                               placeholder="Nhập lại mật khẩu mới" />
                    </div>

                    <button type="submit" class="profile-password-btn">
                        Đổi mật khẩu
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>